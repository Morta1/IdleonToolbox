# set -f stops pages/tools/builds/[slug].jsx from being read as a glob.
set -f
# Tests that read source files from disk instead of importing them, so vitest related never connects them to the
# files they check: a staged component with noSsr in it would pass the quick hook. They run on every quick commit.
# A new test that scans sources (readFileSync, readdirSync, helpers/source-files) must join this list.
SOURCE_SCANS="__test__/no-nossr.test.js __test__/alt-text.test.js __test__/card-spacing.test.js __test__/firebase-lazy.test.js
  __test__/components/leaderboards/jsx-comment-text.test.js __test__/utility/goals-header-only.test.js
  __test__/components/shell-contracts.test.js
  __test__/parsers/arcade-bonus.test.js __test__/parsers/sailing-locked-shape.test.js __test__/parsers/talent-vs-game.test.js
  __test__/data/website-data-barrel.test.js __test__/gameNotation.test.js __test__/theme-vars.test.js __test__/design-system-doc.test.js"
# game-tables.test.js scans the wiki sources in one test, and the rest of the file takes about 40 s: only that test runs.
SOURCE_SCAN_TEST="__test__/entity-graph/game-tables.test.js"
SOURCE_SCAN_NAME="reads no table without a reader"
# Every commit runs the quick check: the tests that import a staged file, the source scans above, the build's type check
# and eslint on the staged files. The full suite runs once per push (.husky/pre-push), not once per commit: with several
# sessions committing on one checkout, parallel full suites starved each other into 5-10 minute commits.
# FULL_COMMIT=1 runs the full suite here too.
staged=$(git diff --cached --name-only --diff-filter=ACMR)
[ -n "$staged" ] || exit 0
# The type check next build runs (tsconfig.build.json: errors in .ts and .tsx) and eslint run beside the tests.
# tsc's incremental state sits in .next/cache, which builds keep and git ignores.
tsc_log=$(mktemp)
lint_log=$(mktemp)
trap 'rm -f "$tsc_log" "$lint_log"' EXIT
npx tsc --noEmit --incremental -p tsconfig.build.json --tsBuildInfoFile .next/cache/tsc-precommit.tsbuildinfo > "$tsc_log" 2>&1 &
tsc_pid=$!
files=$(git diff --cached --name-only --diff-filter=ACMR -- '*.js' '*.jsx' '*.mjs' '*.ts' '*.tsx')
lint_pid=
if [ -n "$files" ]; then
  npx eslint --no-warn-ignored --pass-on-unpruned-suppressions $files > "$lint_log" 2>&1 &
  lint_pid=$!
fi
if [ "$FULL_COMMIT" = "1" ]; then
  npm test
else
  # Every parser sits under parsers/index, so vitest related turns one staged parser into ~300 test files. A staged
  # parser runs only the tests that import it by path or are named after it; pre-push catches the rest.
  targets=
  for f in $staged; do
    case "$f" in
      parsers/*.ts|parsers/*.js)
        stem=${f%.*}
        stem=$(printf '%s' "$stem" | awk -F/ '{print (NF>1 ? $(NF-1)"/"$NF : $NF)}')
        base=$(basename "$stem")
        targets="$targets $(grep -rlE "['\"/]$stem['\"]" __test__ --include='*.test.*') $(find __test__ -iname "*$base*.test.*")" ;;
      *) targets="$targets $f" ;;
    esac
  done
  # A test file named on the command line is related to itself, so the scans ride in the same run.
  npx vitest related --run --passWithNoTests $targets $SOURCE_SCANS
  npx vitest run "$SOURCE_SCAN_TEST" -t "$SOURCE_SCAN_NAME"
fi
failed=0
if ! wait "$tsc_pid"; then
  cat "$tsc_log"
  echo "pre-commit: tsc -p tsconfig.build.json found type errors" >&2
  failed=1
fi
if [ -n "$lint_pid" ] && ! wait "$lint_pid"; then
  cat "$lint_log"
  echo "pre-commit: eslint found errors" >&2
  failed=1
fi
exit $failed
